# Root gitignore for the EWW monorepo (now website-only)
# The mobile app lives in its own repo: github.com/aleksfilmore/ewwniverse-app
# (worked on at C:/dev/ewwniverse-app). Keep it out of this repo.
ewwniverse-app/

# Source art/audio for books + app — kept out of this website repo.
# (Originals live with book/app production, not the marketing site.)
/images/
/fonts/
/sounds/
/creepy creatures/
/creepy dinosaurs/
/creepy earth/
/special unlocks/

# Dependencies — never commit node_modules
node_modules/
**/node_modules/

# Expo
.expo/
**/.expo/
expo-env.d.ts

# Next.js
ewwniverse/.next/
ewwniverse/out/
ewwniverse/.swc/

# EAS native build output
ewwniverse-app/android/
ewwniverse-app/ios/

# Build artifacts
dist/
build/
web-build/
*.tsbuildinfo

# Environment secrets — never commit
.env
.env.local
.env*.local
google-services.json
GoogleService-Info.plist
play-store-key.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Keys and certs
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
